/* Guide Alerts */
"guide_bluetooth_title" = "Ativar Bluetooth";
"guide_bluetooth_message" = "O BinderClip usa Bluetooth como contingência automática quando o Wi-Fi ou a malha estão indisponíveis.\n\nPara ativar o Bluetooth:\n1. Clique em “Abrir Ajustes do Sistema” abaixo.\n2. No painel de Bluetooth, ative o Bluetooth.\n3. O BinderClip retomará o anúncio automaticamente.";
"guide_bluetooth_permission_title" = "Permitir Bluetooth para o BinderClip";
"guide_bluetooth_permission_message" = "O BinderClip usa Bluetooth Low Energy para sincronizar sem Wi-Fi.\n\nPara permitir o Bluetooth:\n1. Clique em “Abrir Ajustes do Sistema” abaixo.\n2. Em Privacidade e Segurança → Bluetooth, ative a opção para o BinderClip.\n3. Se solicitado, reinicie o BinderClip.";
"guide_local_network_title" = "Permitir Rede Local para o BinderClip";
"guide_local_network_message" = "O BinderClip precisa de acesso à Rede Local para descobrir telefones na sua rede Wi-Fi.\n\nPara permitir a Rede Local:\n1. Clique em “Abrir Ajustes do Sistema” abaixo.\n2. Em Privacidade e Segurança → Rede Local, ative o BinderClip.";
"guide_clipboard_title" = "Permitir Acesso à Área de Transferência para o BinderClip";
"guide_clipboard_message" = "O BinderClip precisa de acesso à área de transferência para sincronizar texto e imagens.\n\nPara permitir o acesso:\n1. Clique em “Abrir Ajustes do Sistema” abaixo.\n2. Em Privacidade e Segurança, certifique-se de permitir o acesso para o BinderClip.";

