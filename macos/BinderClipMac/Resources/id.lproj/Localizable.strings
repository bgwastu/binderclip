/* Guide Alerts */
"guide_bluetooth_title" = "Aktifkan Bluetooth";
"guide_bluetooth_message" = "BinderClip menggunakan Bluetooth sebagai cadangan otomatis saat Wi-Fi dan mesh tidak terjangkau.\n\nUntuk mengaktifkan Bluetooth:\n1. Klik “Buka Pengaturan Sistem” di bawah.\n2. Pada panel Bluetooth, aktifkan Bluetooth.\n3. BinderClip akan otomatis melanjutkan siaran setelah Bluetooth aktif.";
"guide_bluetooth_permission_title" = "Izinkan Bluetooth untuk BinderClip";
"guide_bluetooth_permission_message" = "BinderClip menggunakan Bluetooth Hemat Energi sebagai cadangan otomatis saat Wi-Fi tidak terjangkau.\n\nUntuk mengaktifkan Bluetooth:\n1. Klik “Buka Pengaturan Sistem” di bawah.\n2. Di Privasi & Keamanan → Bluetooth, aktifkan sakelar untuk BinderClip.\n3. Jika diminta, mulai ulang BinderClip.";
"guide_local_network_title" = "Izinkan Jaringan Lokal untuk BinderClip";
"guide_local_network_message" = "BinderClip memerlukan akses Jaringan Lokal untuk menemukan dan menyinkronkan dengan ponsel di jaringan Wi-Fi Anda.\n\nUntuk mengaktifkan Jaringan Lokal:\n1. Klik “Buka Pengaturan Sistem” di bawah.\n2. Di Privasi & Keamanan → Jaringan Lokal, aktifkan sakelar untuk BinderClip.";
"guide_clipboard_title" = "Izinkan Akses Papan Klip untuk BinderClip";
"guide_clipboard_message" = "BinderClip memerlukan Akses Papan Klip untuk menyinkronkan teks dan gambar yang disalin dengan perangkat Anda yang dipasangkan.\n\nUntuk mengaktifkan Akses Papan Klip:\n1. Klik “Buka Pengaturan Sistem” di bawah.\n2. Di Privasi & Keamanan, pastikan BinderClip diizinkan mengakses papan klip.";

