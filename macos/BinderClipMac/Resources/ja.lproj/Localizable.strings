/* Guide Alerts */
"guide_bluetooth_title" = "Bluetooth をオンにする";
"guide_bluetooth_message" = "BinderClip は、Wi-Fi やメッシュネットワークが届かない場合に Bluetooth を自動フォールバックとして使用します。\n\nBluetooth をオンにする手順:\n1. 下の「システム設定を開く」をクリックします。\n2. Bluetooth 設定で Bluetooth をオンにします。\n3. Bluetooth がオンになると自動的に再開します。";
"guide_bluetooth_permission_title" = "BinderClip に Bluetooth を許可";
"guide_bluetooth_permission_message" = "BinderClip は、Wi-Fi が届かない場合のフォールバックとして Bluetooth Low Energy を使用します。\n\n許可する手順:\n1. 下の「システム設定を開く」をクリックします。\n2. 「プライバシーとセキュリティ」→「Bluetooth」で BinderClip をオンにします。\n3. 必要に応じて BinderClip を再起動します。";
"guide_local_network_title" = "BinderClip にローカルネットワークを許可";
"guide_local_network_message" = "BinderClip は Wi-Fi ネットワーク上の端末を検出・同期するためにローカルネットワークへのアクセスが必要です。\n\n許可する手順:\n1. 下の「システム設定を開く」をクリックします。\n2. 「プライバシーとセキュリティ」→「ローカルネットワーク」で BinderClip をオンにします。";
"guide_clipboard_title" = "BinderClip にクリップボードへのアクセスを許可";
"guide_clipboard_message" = "BinderClip はコピーしたテキストや画像を同期するためにクリップボードアクセスが必要です。\n\n許可する手順:\n1. 下の「システム設定を開く」をクリックします。\n2. 「プライバシーとセキュリティ」で BinderClip のアクセスが許可されていることを確認します。";

