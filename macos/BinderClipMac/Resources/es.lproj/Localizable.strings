/* Guide Alerts */
"guide_bluetooth_title" = "Activar Bluetooth";
"guide_bluetooth_message" = "BinderClip usa Bluetooth como respaldo automático cuando no hay conexión por Wi-Fi o red mesh.\n\nPara activar Bluetooth:\n1. Haga clic en “Abrir Ajustes del Sistema” abajo.\n2. En el panel de Bluetooth, active Bluetooth.\n3. BinderClip reanudará automáticamente la detección.";
"guide_bluetooth_permission_title" = "Permitir Bluetooth para BinderClip";
"guide_bluetooth_permission_message" = "BinderClip utiliza Bluetooth de baja energía como respaldo cuando la red Wi-Fi no está disponible.\n\nPara permitir Bluetooth:\n1. Haga clic en “Abrir Ajustes del Sistema” abajo.\n2. En Privacidad y seguridad → Bluetooth, active BinderClip.\n3. Si se le solicita, reinicie BinderClip.";
"guide_local_network_title" = "Permitir red local para BinderClip";
"guide_local_network_message" = "BinderClip necesita acceso a la Red Local para descubrir y sincronizarse con teléfonos en su red Wi-Fi.\n\nPara permitir la Red Local:\n1. Haga clic en “Abrir Ajustes del Sistema” abajo.\n2. En Privacidad y seguridad → Red local, active BinderClip.";
"guide_clipboard_title" = "Permitir acceso al portapapeles para BinderClip";
"guide_clipboard_message" = "BinderClip necesita acceso al portapapeles para sincronizar texto e imágenes con sus dispositivos emparejados.\n\nPara permitir el acceso:\n1. Haga clic en “Abrir Ajustes del Sistema” abajo.\n2. En Privacidad y seguridad, asegúrese de permitir el acceso a BinderClip.";

